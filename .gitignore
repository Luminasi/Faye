# ============================================================
# E-Commerce RAG Knowledge QA System - root .gitignore
# ============================================================

# ---- Python / FastAPI backend runtime garbage ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
PYMETA_TMP/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
coverage.xml
.coverage
.tox/
.nox/

# ---- Backend virtual env + secrets (CRITICAL: DO NOT commit) ----
backend/venv/
backend/.env
# NOTE: backend/.env.example is tracked intentionally as a template

# ---- Backend runtime-generated databases / vector stores ----
# (Re-created automatically by app startup event + seed_demo.bat)
backend/data/app.db
backend/data/app.db-journal
backend/data/*.sqlite3
backend/data/chroma/
backend/data/uploads/chunks/
backend/data/uploads/*.log
# NOTE: backend/data/sample_docs/*.md ARE TRACKED (demo docs source of truth)

# ---- Uploaded runtime files / cache ----
backend/data/uploads/*.pdf
backend/data/uploads/*.docx
backend/data/uploads/*.txt
backend/data/uploads/*.md
# ChromaDB 集合运行时数据（历史路径遗留，勿提交）
backend/data/uploads/kb_*/

# ---- 本地杂项 ----
sqlite_mcp_server.db

# ---- Node.js / Vite frontend ----
# Note: frontend/.gitignore also exists and handles node_modules etc,
# but we repeat here for root-level git tracking safety.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.DS_Store
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ---- IDE / Editor ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
.project
.classpath
.settings/

# ---- OS junk ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.lnk

# ---- Logs ----
*.log
logs/

# ---- Temp / cache ----
*.tmp
*.bak
*.crswap
.cache/
