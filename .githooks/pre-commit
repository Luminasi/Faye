#!/usr/bin/env bash
# ============================================================
# 质量门禁 pre-commit hook（三模式：strict / ask / off）
#
# 校验 .claude/markers/ 下 test/quality 通过标记与本次提交一致：
#   - 两个标记都存在且 HEAD / DIFF_HASH 与当前提交状态匹配 → 通过，删除标记放行
#   - 否则按 .githooks/gate.config 中的模式处理：
#       strict : 直接拦截（exit 1）
#       ask    : 交互询问是否强制提交（默认拒绝）；非交互环境默认拦截
#       off    : 直接放行
#
# 模式切换：bash .githooks/gate.sh strict|ask|off
# ============================================================
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
MARKER_DIR="$ROOT/.claude/markers"
GATE_CONFIG="$ROOT/.githooks/gate.config"
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'

# ---------- 工具函数 ----------
# 计算当前提交内容指纹（staged diff + untracked 文件）
# 算法必须与 skills（tester / quality-engineer）生成 marker 时一致
compute_current_hash() {
  if git rev-parse --verify HEAD >/dev/null 2>&1; then
    AGAINST=HEAD
  else
    AGAINST=$(git hash-object -t tree /dev/null)
  fi
  (
    git diff --cached "$AGAINST"
    git ls-files --others --exclude-standard | while read -r f; do
      echo "UNTRACKED:$f"
      cat "$f" 2>/dev/null
    done
  ) | sha256sum | cut -d' ' -f1
}

# 校验单个 marker 是否有效：存在 + HEAD 匹配 + DIFF_HASH 匹配
check_marker() {
  local name="$1"
  local marker="$MARKER_DIR/$name"
  [ -f "$marker" ] || return 1

  local marker_head marker_hash cur_head
  marker_head=$(grep '^HEAD=' "$marker" | cut -d= -f2-)
  marker_hash=$(grep '^DIFF_HASH=' "$marker" | cut -d= -f2-)
  [ -n "$marker_head" ] && [ -n "$marker_hash" ] || return 1

  cur_head=$(git rev-parse HEAD 2>/dev/null || echo "initial")
  [ "$marker_head" = "$cur_head" ] || return 1
  [ "$marker_hash" = "$(compute_current_hash)" ] || return 1
  return 0
}

# ---------- 主流程 ----------
TEST_OK=0; QUALITY_OK=0
check_marker test-passed.marker && TEST_OK=1
check_marker quality-passed.marker && QUALITY_OK=1

if [ "$TEST_OK" = "1" ] && [ "$QUALITY_OK" = "1" ]; then
  echo -e "${GREEN}✅ 质量门禁通过：测试与质量检查均已通过（/gitcommit-save）${NC}"
  rm -f "$MARKER_DIR/test-passed.marker" "$MARKER_DIR/quality-passed.marker"
  exit 0
fi

# 读取门禁模式（默认 ask）
MODE="ask"
if [ -f "$GATE_CONFIG" ]; then
  MODE=$(tr -d '[:space:]' < "$GATE_CONFIG")
fi
case "$MODE" in
  strict|ask|off) ;;
  *) MODE="ask" ;;
esac

echo -e "${YELLOW}⚠️  质量门禁未通过：${NC}"
[ "$TEST_OK" = "1" ] || echo "   - 缺少有效的 test-passed.marker（未运行 /tester 或测试未通过）"
[ "$QUALITY_OK" = "1" ] || echo "   - 缺少有效的 quality-passed.marker（未运行 /quality-engineer 或存在阻塞问题）"
echo "     请运行 /gitcommit-save 完成检查后提交，或 git commit --no-verify 跳过。"

case "$MODE" in
  strict)
    echo -e "${RED}🚫 门禁模式 [strict]：强制拦截提交。${NC}"
    exit 1
    ;;
  off)
    echo -e "${YELLOW}⏩ 门禁模式 [off]：放行提交。${NC}"
    rm -f "$MARKER_DIR/test-passed.marker" "$MARKER_DIR/quality-passed.marker"
    exit 0
    ;;
  ask)
    if [ -t 0 ]; then
      echo -e "${YELLOW}❓ 门禁模式 [ask]：质量检查未通过，仍要强制提交吗？${NC}"
      read -r -p "继续提交？(y/N) " answer < /dev/tty 2>/dev/null || answer=""
      case "${answer:-n}" in
        y|Y|yes|YES)
          echo -e "${YELLOW}⏩ 已确认强制提交。${NC}"
          rm -f "$MARKER_DIR/test-passed.marker" "$MARKER_DIR/quality-passed.marker"
          exit 0
          ;;
        *)
          echo -e "${RED}🚫 已取消提交。请先运行 /gitcommit-save 完成质量检查。${NC}"
          exit 1
          ;;
      esac
    else
      echo -e "${RED}🚫 非交互环境 [ask] 模式默认拦截提交。${NC}"
      exit 1
    fi
    ;;
esac
