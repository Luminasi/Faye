# ===== 应用配置 =====
APP_NAME=电商RAG知识库问答系统
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8002

# ===== 数据库配置（SQLite） =====
DATABASE_URL=sqlite:///./data/app.db

# ===== JWT 配置 =====
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== LLM（问答大模型）：本地 Ollama（默认）或 远程 API（DeepSeek 等 OpenAI 兼容）=====
# 可选值：openai_compatible（远程）| ollama（本地）
LLM_PROVIDER=ollama

# ---- 远程（备选：切回远程时改 LLM_PROVIDER=openai_compatible 并填真实 Key）----
# 控制台显示名"DeepSeek-V4-Flash"对应 API model id = deepseek-chat
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=sk-your-real-key-here
OPENAI_COMPAT_MODEL=deepseek-chat
OPENAI_COMPAT_TEMPERATURE=0.2
OPENAI_COMPAT_TOP_P=0.9
OPENAI_COMPAT_MAX_TOKENS=4096
OPENAI_COMPAT_TIMEOUT_SECS=120

# ---- 本地 Ollama ----
# 首次使用请先运行：
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# 如需要 128k 上下文版本（复用 qwen2.5:7b 权重，零下载）：
#   printf 'FROM qwen2.5:7b\nPARAMETER num_ctx 131072\n' | ollama create qwen2.5:7b-128k
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-128k
# 上下文窗口：128k = 131072。内存不足可调小（如 32768 为原生 32k）
OLLAMA_NUM_CTX=131072
# 嵌入模型默认继续用本地 Ollama（不需要重建向量库），不要改动
OLLAMA_EMBED_MODEL=nomic-embed-text

# ===== ChromaDB 向量库配置 =====
CHROMA_PERSIST_DIR=./data/chroma

# ===== 文件上传配置 =====
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ===== 管理员初始账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_EMAIL=admin@example.com

# ===== 缓存配置 =====
QUERY_CACHE_MAXSIZE=1000
QUERY_CACHE_TTL_SECONDS=3600
EMBED_CACHE_MAXSIZE=10000
